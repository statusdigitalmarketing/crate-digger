{
  "name": "crate-digger",
  "version": "2.1.0",
  "description": "MCP server that classifies music tracks by mood, energy, and subgenre vibe using lyrics analysis + spectral audio features + Spotify",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "crate-digger": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --legal-comments=eof --outfile=release/crate-digger/crate-digger.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "meyda": "^5.6.3",
    "node-wav": "^0.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "esbuild": "^0.25.12",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
